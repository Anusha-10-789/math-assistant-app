CORS_ORIGINS=http://localhost:5173

# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required. The single login (POST /login) that gates every route in this app
# (/generate, /download/*, /lecture-video). Pick your own values.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional. Enables the "Sign in with Google" button on the login screen.
# Create one at https://console.cloud.google.com/ (APIs & Services >
# Credentials > Create Credentials > OAuth client ID > Web application),
# with http://localhost:5183 (or your deployed frontend URL) as an
# authorized JavaScript origin. Leave blank to hide the button.
GOOGLE_CLIENT_ID=

# Optional. Enables the "Watch on YouTube" option next to each question's
# explanation, which searches for a kid-friendly video on the topic. Create
# one at https://console.cloud.google.com/ (APIs & Services > Library >
# enable "YouTube Data API v3", then Credentials > Create Credentials > API
# key). Free tier default quota is 10,000 units/day (100 units per search;
# results are cached per topic+grade). Leave blank to hide the option.
YOUTUBE_API_KEY=

# Optional. Enables "Forgot password?" to actually email a reset link,
# instead of returning a 503. Works with any standard SMTP provider —
# Gmail (smtp.gmail.com, port 587, an App Password as SMTP_PASSWORD),
# SendGrid, Mailgun, Outlook/Office365, or a custom mail server. Leave
# SMTP_HOST blank to disable (the request endpoint returns a clear error
# instead of silently failing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME if left blank.
SMTP_FROM_EMAIL=
# Set to "false" only if your provider requires a plain (non-STARTTLS)
# connection — almost never needed.
SMTP_USE_TLS=true

# Optional. The frontend's own URL, used to build the link inside the
# password-reset email (e.g. https://yourapp.example). Defaults to the
# first entry in CORS_ORIGINS if left blank.
FRONTEND_URL=

# Optional. Enables the "Text Me My Result" button on the test summary
# screen, which sends the score via SMS using Twilio. Create a free trial
# account at https://console.twilio.com/, get a Twilio phone number, and
# find your Account SID + Auth Token on the console dashboard. Leave
# TWILIO_ACCOUNT_SID blank to hide the button.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number, in E.164 format (e.g. +15551234567).
TWILIO_FROM_NUMBER=
# Country code added to phone numbers saved without one (e.g. 9876543210).
SMS_DEFAULT_COUNTRY_CODE=+91

# Optional locally, needed on Render's free plan. A Postgres URL (e.g. from a
# free Neon or Supabase database) where accounts are stored. Leave blank to
# keep accounts in backend/data/users.json.
DATABASE_URL=

# Local testing only — never on a public server. When "true", one-time codes
# that can't be sent (no SMTP/Twilio set up) are printed to this console.
OTP_DEV_CONSOLE=
